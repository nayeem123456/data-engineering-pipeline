# ==============================================================================
# Production-Style Data Lakehouse & ETL Platform - Environment Configuration
# ==============================================================================

# Execution Environment: development, staging, production
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# ------------------------------------------------------------------------------
# Storage Paths
# ------------------------------------------------------------------------------
DATA_DIR=data
LAKEHOUSE_BASE_PATH=data/lakehouse
BRONZE_BASE_PATH=data/lakehouse/bronze
SILVER_BASE_PATH=data/lakehouse/silver
GOLD_BASE_PATH=data/lakehouse/gold
QUARANTINE_BASE_PATH=data/lakehouse/quarantine
LOGS_DIR=logs

# ------------------------------------------------------------------------------
# PostgreSQL Metadata and Serving Database
# ------------------------------------------------------------------------------
POSTGRES_USER=lakehouse_admin
POSTGRES_PASSWORD=lakehouse_secure_pass_2026
POSTGRES_DB=lakehouse_dw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://lakehouse_admin:lakehouse_secure_pass_2026@postgres:5432/lakehouse_dw

# Local SQLite fallback for zero-infrastructure standalone test runs
USE_SQLITE_METADATA_FALLBACK=true
SQLITE_DB_PATH=data/metadata_store.db

# ------------------------------------------------------------------------------
# Apache Airflow Configuration
# ------------------------------------------------------------------------------
AIRFLOW_IMAGE_NAME=apache/airflow:2.8.1-python3.11
AIRFLOW_UID=50000
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=false
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://lakehouse_admin:lakehouse_secure_pass_2026@postgres:5432/lakehouse_dw
AIRFLOW_FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqBpPo=

# ------------------------------------------------------------------------------
# PySpark Configuration
# ------------------------------------------------------------------------------
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g
SPARK_EXECUTOR_MEMORY=2g
SPARK_SQL_SHUFFLE_PARTITIONS=4

# ------------------------------------------------------------------------------
# Data Pipeline Ingestion & Watermarking
# ------------------------------------------------------------------------------
DEFAULT_BATCH_SIZE=5000
LATE_ARRIVING_GRACE_PERIOD_HOURS=24
DATA_QUALITY_MAX_ERROR_THRESHOLD=0
STREAMLIT_SERVER_PORT=8501
